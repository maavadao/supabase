# Copy to supabase/.env. Credentials for the dev-only Google and GitHub OAuth
# apps (callback URL: http://127.0.0.1:54321/auth/v1/callback). Never use the
# production OAuth apps here.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
